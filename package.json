{
  "name": "creator-bd-agent",
  "version": "5.5.2",
  "private": true,
  "type": "module",
  "description": "Creator BD backend with IMAP sync, Feishu matching, automatic Chinese summaries, and quote extraction.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "express": "5.2.1",
    "imapflow": "^1.6.5",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.4",
    "openai": "^7.4.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "22.19.15",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.5",
    "typescript": "7.0.2"
  }
}
